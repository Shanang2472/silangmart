# HTTPS is optional for local desktop-only use.
# To enable phone GPS and Rider PWA installation on your LAN, configure both
# variables with a certificate whose SAN includes your server's LAN IP.
PORT=3000
HTTPS_CERT_FILE=certs/lan-cert.pem
HTTPS_KEY_FILE=certs/lan-key.pem
# Leave empty for same-origin local development. Set to the Render API URL in Vercel.
VITE_API_BASE_URL=
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=

# Cloud deployment (keep credentials out of frontend VITE_* variables)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=silang_mini_mart
# For Aiven, provide the downloaded CA certificate contents or set MYSQL_SSL_CA_FILE.
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
